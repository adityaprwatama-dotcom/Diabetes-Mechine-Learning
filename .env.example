# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK di-upload ke GitHub.
# Kunci rahasia untuk sesi login (isi dengan teks acak panjang).
FLASK_SECRET_KEY=ganti-dengan-teks-acak-panjang

# Koneksi MySQL (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=healthcheck
DB_USER=healthcheck
DB_PASSWORD=isi-kata-sandi-user-mysql

# Alamat halaman web yang boleh memanggil API (dipisah koma)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
